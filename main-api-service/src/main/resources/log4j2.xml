<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
        <!--
            Override LOG_DIR at startup:
              java -DAPP_LOG_DIR=/var/log/main-api-service -jar main-api-service-1.0.0.jar
            Local dev default: logs/
            EC2 production:    /var/log/main-api-service/
        -->
        <Property name="LOG_DIR">${sys:APP_LOG_DIR:-logs}</Property>
        <Property name="APP_NAME">main-api-service</Property>
    </Properties>

    <Appenders>

        <!-- Console — for local dev and systemd journal on EC2 -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!--
            Rolling file appender
            Active file  : logs/main-api-service.log
            Rolled file  : logs/main-api-service-2026-04-16-14.log.gz  (hourly, gzipped)
            Retention    : 30 days (720 hourly files max)
            Size trigger : 50 MB (safety net for very busy periods)

            Grep rolled files on EC2:
              zcat /var/log/main-api-service/main-api-service-*.log.gz | grep ERROR
        -->
        <RollingFile name="FileAppender"
                     fileName="${LOG_DIR}/${APP_NAME}.log"
                     filePattern="${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd-HH}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="720">
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${APP_NAME}-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!--
            All three services' application code logs at INFO.
            A single logger covers all three packages because they all start
            with com.equity — no need for separate entries.
        -->
        <Logger name="com.equity" level="INFO" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Spring framework — WARN only (reduces startup + request noise) -->
        <Logger name="org.springframework" level="WARN" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Hibernate — WARN in production; switch to DEBUG locally to see SQL -->
        <Logger name="org.hibernate" level="WARN" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Root — catch-all for any third-party libraries -->
        <Root level="WARN">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Root>

    </Loggers>

</Configuration>
