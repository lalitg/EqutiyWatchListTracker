# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Local:  load it before starting the service, e.g. in PowerShell
#           Get-Content .env | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }
#           java -jar payment-service/target/payment-service-0.0.1-SNAPSHOT-exec.jar
#         or pass them on the command line with -DRAZORPAY_KEY_ID=... -DRAZORPAY_KEY_SECRET=...
#
# Server: these belong in /opt/niveshflow/.env, which systemd loads for the service.

# Razorpay API keys. Test keys start rzp_test_, live keys rzp_live_.
# The key id is public — it is sent to the browser to open the checkout.
# The key secret signs and verifies payments. It must never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set in the Razorpay dashboard when the webhook endpoint is registered. Razorpay signs every
# webhook with it, and WebhookHandler refuses anything that does not match.
RAZORPAY_WEBHOOK_SECRET=

# The paywall's kill switch. false grants every user the ADVANCED tier, so a billing problem
# unlocks the product instead of locking paying customers out of what they bought.
BILLING_ENABLED=true

# Shared by the services for internal lookups (watchlist-service asks payment-service what a
# user is entitled to). Override the development default in production.
INTERNAL_API_KEY=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=watchlisttracker
DB_USERNAME=postgres
DB_PASSWORD=
