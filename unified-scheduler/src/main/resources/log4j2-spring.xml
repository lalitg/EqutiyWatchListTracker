<?xml version="1.0" encoding="UTF-8"?>
<!--
    Unified Log4j2 configuration for the single-JVM launcher (unified-scheduler).

    Log4j2 is a JVM-level singleton — initialised ONCE by whichever Spring context
    boots first. UnifiedSchedulerApplication.main() pins this file via:
        System.setProperty("logging.config", "classpath:log4j2-spring.xml")
    before any service thread starts, guaranteeing this config is used regardless
    of the startup order of the 6 service contexts.

    Appenders:
      CONSOLE    — real-time output to SYSTEM_OUT (dev / Docker / journalctl)
      FILE       — rolling file: daily rollover + 50 MB size cap, 30-day/500 MB retention
      ASYNC_FILE — non-blocking wrapper around FILE; disk I/O on a background thread
                   so scheduler and fetch threads are never stalled by slow writes

    Application loggers (INFO):
      com.watchlist.global    — global-watchlist-service (port 8083)
      com.companycode.nse     — nse-code-service / nse-enterprise-scheduler (port 8082)
      com.nseevents           — nse-events-scheduler (port 8085)
      com.companynews         — nse-news-scheduler (port 8084)
      com.equity.fastmovers   — fast-movers-service (port 8081)
      com.equity.fundamentals — fundamentals-service (port 8086)
      com.unified             — this launcher

    Framework loggers (WARN — suppress routine noise):
      org.springframework, org.hibernate, com.zaxxer.hikari,
      org.flywaydb, io.github.resilience4j, net.javacrumbs.shedlock
-->
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %5level [%t] %logger{36} : %msg%n</Property>
        <Property name="LOG_FILE">logs/unified-scheduler.log</Property>
        <Property name="LOG_ARCHIVE">logs/unified-scheduler.%d{yyyy-MM-dd}.%i.log.gz</Property>
    </Properties>

    <Appenders>

        <!-- Console — terminal / Docker stdout / EC2 journalctl -->
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- Rolling file — daily rollover + 50 MB size cap, gzip compressed archives -->
        <RollingFile name="FILE"
                     fileName="${LOG_FILE}"
                     filePattern="${LOG_ARCHIVE}">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <!-- Auto-delete archives older than 30 days or when total exceeds 500 MB -->
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName glob="unified-scheduler.*.log.gz"/>
                    <IfAccumulatedFileSize exceeds="500MB"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!--
            Async wrapper — all disk writes on a dedicated background I/O thread.
            bufferSize=2048: holds up to 2048 log events in-memory before blocking,
            enough for 6 concurrent schedulers at peak throughput.
            includeLocation=false: skips expensive stack-frame lookup for performance.
        -->
        <Async name="ASYNC_FILE" bufferSize="2048" includeLocation="false">
            <AppenderRef ref="FILE"/>
        </Async>

    </Appenders>

    <Loggers>

        <!-- ── Framework internals — WARN only (suppress startup noise) ──── -->
        <Logger name="org.springframework"           level="WARN" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>
        <Logger name="org.hibernate"                 level="WARN" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>
        <Logger name="com.zaxxer.hikari"             level="WARN" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>
        <Logger name="org.flywaydb"                  level="WARN" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>
        <Logger name="io.github.resilience4j"        level="WARN" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>
        <Logger name="net.javacrumbs.shedlock"       level="WARN" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>
        <Logger name="com.rometools"                 level="WARN" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>
        <Logger name="org.apache.http"               level="WARN" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>

        <!-- ── Application packages — INFO ──────────────────────────────── -->

        <!-- global-watchlist-service (port 8083) -->
        <Logger name="com.watchlist.global" level="INFO" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>

        <!-- nse-enterprise-scheduler / nse-code-service (port 8082) -->
        <Logger name="com.companycode.nse" level="INFO" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>

        <!-- nse-events-scheduler (port 8085) -->
        <Logger name="com.nseevents" level="INFO" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>

        <!-- nse-news-scheduler (port 8084) -->
        <Logger name="com.companynews" level="INFO" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>

        <!-- fast-movers-service (port 8081) -->
        <Logger name="com.equity.fastmovers" level="INFO" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>

        <!-- fundamentals-service (port 8086) -->
        <Logger name="com.equity.fundamentals" level="INFO" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>

        <!-- unified-scheduler launcher -->
        <Logger name="com.unified" level="INFO" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Logger>

        <!-- Root — catch-all for any library not explicitly listed above -->
        <Root level="WARN">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ASYNC_FILE"/>
        </Root>

    </Loggers>

</Configuration>
