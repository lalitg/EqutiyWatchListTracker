<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        unified-scheduler — single executable fat JAR that starts all 6 services
        in one JVM. Each service runs in its own Spring ApplicationContext on its
        own thread; they share the JVM heap and Log4j2 instance but have fully
        isolated beans, DataSources, schedulers, and schema management.

        Build order (enforced by root pom.xml):
          1. global-watchlist-service  →  global-watchlist-service-1.0.0.jar
          2. nse-code-service          →  nse-enterprise-scheduler-1.0.0.jar
          3. nse-events-scheduler      →  nse-events-scheduler-0.0.1-SNAPSHOT.jar
          4. nse-news-scheduler        →  nse-news-scheduler-0.0.1-SNAPSHOT.jar
          5. sebi-data-service         →  sebi-data-service-1.0.0.jar
          6. fundamentals-service      →  fundamentals-service-0.0.1-SNAPSHOT.jar
          7. unified-scheduler         →  unified-scheduler-1.0.0.jar  (this module)
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
    </parent>

    <groupId>com.equitywatchlist</groupId>
    <artifactId>unified-scheduler</artifactId>
    <version>1.0.0</version>
    <name>unified-scheduler</name>
    <description>Single-JVM launcher for all 6 equity watchlist scheduler services</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!--
            The 6 service JARs — plain (non-exec) artifacts produced because each
            service's spring-boot-maven-plugin is configured with classifier=exec.
            Maven includes their classes and pulls in all transitive dependencies.

            Services: global-watchlist, nse-code, nse-events, nse-news, sebi-data, fundamentals
        -->
        <dependency>
            <groupId>com.watchlist</groupId>
            <artifactId>global-watchlist-service</artifactId>
            <version>1.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.watchlist</groupId>
            <artifactId>nse-enterprise-scheduler</artifactId>
            <version>1.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.nseevents</groupId>
            <artifactId>nse-events-scheduler</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.companynews</groupId>
            <artifactId>nse-news-scheduler</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.equity</groupId>
            <artifactId>sebi-data-service</artifactId>
            <version>1.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.equity</groupId>
            <artifactId>fundamentals-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            Log4j2 backend — declared explicitly here to guarantee it wins
            in dependency mediation. All 6 service JARs already depend on
            spring-boot-starter-log4j2, so this is a safety net.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!--
            ShedLock — required by nse-enterprise-scheduler (nse-code-service).
            Both artifacts must be on the classpath at runtime so Spring can
            proxy @SchedulerLock methods in the nse-code context.
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>5.10.0</version>
        </dependency>

        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>5.10.0</version>
        </dependency>

        <!--
            Rome — required by nse-news-scheduler for Google RSS feed parsing.
        -->
        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!--
            Resilience4j — required by nse-news-scheduler for @Retry and @CircuitBreaker.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- AOP — required for Resilience4j annotation proxying -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Validation — required by nse-news-scheduler for @NotBlank on controller params -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Actuator — health/metrics endpoints for nse-news-scheduler -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Lombok — required by nse-news-scheduler -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- jsoup — required by sebi-data-service for buybacks HTML parsing -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>

        <!-- Jackson JSR310 — LocalDateTime serialization for multiple services -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        UnifiedSchedulerApplication is a plain Java main class
                        (not @SpringBootApplication), so the plugin cannot
                        auto-detect it — must be declared explicitly.
                    -->
                    <mainClass>com.unified.UnifiedSchedulerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
