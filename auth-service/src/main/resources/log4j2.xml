<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
        <!-- Override LOG_DIR at startup: java -DAPP_LOG_DIR=/var/log/auth-service -jar auth-service.jar -->
        <!-- Local dev default: logs/   EC2: /var/log/auth-service/ -->
        <!-- Note: property name (LOG_DIR) differs from sys property (APP_LOG_DIR) to avoid Log4j2 recursion -->
        <Property name="LOG_DIR">${sys:APP_LOG_DIR:-logs}</Property>
        <Property name="APP_NAME">auth-service</Property>
    </Properties>

    <Appenders>

        <!-- Console appender — output for local dev and Docker -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!--
            Rolling file appender
            - Active file : logs/auth-service.log
            - Rolled file : logs/auth-service-2026-04-13-14.log.gz  (hourly, gzipped)
            - Keeps 30 days of rolled files (720 hourly files max)
            - Also rolls if a single file hits 50 MB (rare, but safe)
            On EC2: grep through rolled files with  zcat auth-service-*.log.gz | grep ERROR
        -->
        <RollingFile name="FileAppender"
                     fileName="${LOG_DIR}/${APP_NAME}.log"
                     filePattern="${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd-HH}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <!-- Roll every hour -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <!-- Keep 30 days × 24 hours = 720 rolled files max -->
            <DefaultRolloverStrategy max="720">
                <!-- Also delete files older than 30 days regardless of count -->
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${APP_NAME}-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- Application code — INFO and above goes to both console and file -->
        <Logger name="com.equity.auth" level="INFO" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Spring framework — WARN only to reduce noise -->
        <Logger name="org.springframework" level="WARN" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Hibernate — WARN in prod; change to DEBUG locally to see SQL queries -->
        <Logger name="org.hibernate" level="WARN" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Root — catch-all for everything else -->
        <Root level="WARN">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Root>

    </Loggers>

</Configuration>
